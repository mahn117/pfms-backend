NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
TRUSTED_PROXY_IPS=

API_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

POSTGRES_USER=pfms
POSTGRES_PASSWORD=pfms
POSTGRES_DB=pfms

DATABASE_URL=postgresql://pfms:pfms@localhost:5432/pfms?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES=7d

OTP_DELIVERY_PROVIDER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=PFMS <no-reply@example.com>
MAIL_SECURE=false
MAIL_CONNECTION_TIMEOUT_MS=10000
SMS_PROVIDER_API_KEY=

UPLOAD_STORAGE=local
UPLOAD_MAX_SIZE_MB=5
